# Postgres (local, Neon or Supabase)
DATABASE_URL=postgres://postgres:password@localhost:5432/hklx_blog

# Admin login
ADMIN_PASSWORD=change-me
# Second login secret: exactly 8 digits. Sign-in is refused if this is missing or not 8 digits.
ADMIN_PIN=
SESSION_SECRET=long-random-string

# Public site
SITE_NAME=Hklx Blog
SITE_URL=http://localhost:3000
# Timezone used for post dates and times (IANA name). Servers like Vercel run on UTC, so set this.
SITE_TIMEZONE=Asia/Kuala_Lumpur

# Images: local | supabase
STORAGE=local
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=blog-images

# Cloudflare Turnstile (every request is gated behind the challenge)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
