{
  "name": "hklx-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:admin && tsx watch src/dev.ts",
    "build:admin": "esbuild src/admin/admin.ts --bundle --minify --format=iife --outfile=public/admin.js",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
