    "dotenv": "^17.0.0",
    "hono": "^4.9.0",
    "marked": "^16.0.0",
    "postgres": "^3.4.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
